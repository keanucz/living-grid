{
  "name": "living-grid-overlays",
  "private": true,
  "version": "0.1.0",
  "description": "Transparent Remotion overlays (titles, lower thirds, captions, number cards) for the in-person demo video.",
  "type": "module",
  "scripts": {
    "snapshot": "node scripts/snapshot.mjs",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:mov": "node scripts/render.mjs mov",
    "render:webm": "node scripts/render.mjs webm",
    "render:png": "node scripts/render.mjs png",
    "render:all": "node scripts/render.mjs mov && node scripts/render.mjs webm && node scripts/render.mjs png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
